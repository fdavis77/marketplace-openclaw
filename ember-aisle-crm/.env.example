# Postgres connection. On Supabase use the *transaction pooler* URL (port 6543)
# from Project Settings → Database, in an EU (London/Frankfurt) region.
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# At least 32 random characters. Generate with: openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=
